# Optional. If this is unset, the app uses the same LAN IP Expo/Metro is using.
# Physical device on Expo tunnel: tunnel does not expose the API. Use LAN mode, or set this
# to http://<your-computer-LAN-IP>:5000/api while the phone is on the same Wi-Fi.
# iOS Simulator & Web: http://localhost:5000/api
# Android Emulator: http://10.0.2.2:5000/api
# Uncomment and replace YOUR-LAN-IP for a physical device:
# EXPO_PUBLIC_API_URL=http://YOUR-LAN-IP:5000/api
